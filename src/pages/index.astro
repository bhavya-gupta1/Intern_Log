---
import { getCollection } from "astro:content";

const posts = (await getCollection("learning")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const totalEntries = posts.length;
const uniqueTags = new Set(posts.flatMap((post) => post.data.tags ?? [])).size;
const latestDate = posts[0]?.data.date;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Intern Learning Timeline</title>
    <meta
      name="description"
      content="A clean learning timeline for internship notes and daily reflections."
    />
    <style>
      :root {
        --bg: #f6f7fb;
        --panel: rgba(255, 255, 255, 0.78);
        --panel-solid: #ffffff;
        --text: #101828;
        --muted: #667085;
        --line: #e4e7ec;
        --accent: #2563eb;
        --accent-soft: rgba(37, 99, 235, 0.12);
        --shadow: 0 18px 50px rgba(16, 24, 40, 0.08);
        --radius: 24px;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background:
          radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 30%),
          radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 26%),
          var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .shell {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        padding: 32px 0 56px;
      }

      .hero {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 20px;
        align-items: end;
        padding: 28px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        background: var(--panel);
        backdrop-filter: blur(18px);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .eyebrow {
        margin: 0 0 10px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.8rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      .lead {
        margin: 14px 0 0;
        max-width: 62ch;
        font-size: 1.02rem;
        line-height: 1.7;
        color: var(--muted);
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .stat {
        padding: 18px 16px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--panel-solid);
      }

      .stat span {
        display: block;
        font-size: 1.6rem;
        font-weight: 750;
        letter-spacing: -0.03em;
      }

      .stat label {
        display: block;
        margin-top: 4px;
        font-size: 0.88rem;
        color: var(--muted);
      }

      .section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 28px 2px 14px;
      }

      .section-title h2 {
        margin: 0;
        font-size: 1rem;
        letter-spacing: 0.02em;
      }

      .section-title p {
        margin: 0;
        font-size: 0.92rem;
        color: var(--muted);
      }

      .timeline {
        display: grid;
        gap: 16px;
      }

      .entry {
        display: grid;
        grid-template-columns: 24px minmax(0, 1fr);
        gap: 14px;
        align-items: stretch;
      }

      .rail {
        position: relative;
        display: flex;
        justify-content: center;
      }

      .dot {
        width: 14px;
        height: 14px;
        margin-top: 22px;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 0 6px var(--accent-soft);
        z-index: 1;
      }

      .line {
        position: absolute;
        top: 40px;
        bottom: -16px;
        width: 2px;
        background: linear-gradient(to bottom, rgba(37, 99, 235, 0.55), rgba(37, 99, 235, 0.08));
      }

      .card {
        padding: 22px 22px 20px;
        border: 1px solid rgba(228, 231, 236, 0.95);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 10px 28px rgba(16, 24, 40, 0.05);
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 38px rgba(16, 24, 40, 0.08);
        border-color: rgba(37, 99, 235, 0.2);
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
      }

      .date {
        font-size: 0.9rem;
        color: var(--muted);
        font-weight: 600;
      }

      .badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--accent);
        background: var(--accent-soft);
      }

      .card h3 {
        margin: 0;
        font-size: 1.2rem;
        line-height: 1.35;
        letter-spacing: -0.02em;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }

      .tag {
        padding: 6px 10px;
        border-radius: 999px;
        background: #f2f4f7;
        color: #475467;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .empty {
        margin-top: 18px;
        padding: 28px;
        border: 1px dashed #d0d5dd;
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.65);
        color: var(--muted);
        text-align: center;
      }

      .footer {
        margin-top: 28px;
        padding: 16px 2px 0;
        font-size: 0.9rem;
        color: var(--muted);
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .stats {
          grid-template-columns: 1fr 1fr 1fr;
        }
      }

      @media (max-width: 640px) {
        .shell {
          width: min(100% - 20px, 1120px);
          padding: 16px 0 30px;
        }

        .hero {
          padding: 20px;
        }

        .stats {
          grid-template-columns: 1fr;
        }

        .card {
          padding: 18px;
        }

        .section-title {
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="hero">
        <div>
          <p class="eyebrow">Intern Learning Log</p>
          <h1>My Internship Timeline</h1>
          <p class="lead">
            A clean, calm space to record what I learned each day, week, or project milestone.
            Markdown stays separate; the website just presents it beautifully.
          </p>
        </div>

        <div class="stats" aria-label="Timeline stats">
          <div class="stat">
            <span>{totalEntries}</span>
            <label>Entries</label>
          </div>
          <div class="stat">
            <span>{uniqueTags}</span>
            <label>Tags</label>
          </div>
          <div class="stat">
            <span>{latestDate ? formatDate(latestDate) : "—"}</span>
            <label>Latest entry</label>
          </div>
        </div>
      </section>

      <div class="section-title">
        <h2>Timeline</h2>
        <p>Newest notes first</p>
      </div>

      {posts.length ? (
        <section class="timeline">
          {posts.map((post, index) => (
            <article class="entry">
              <div class="rail" aria-hidden="true">
                <div class="dot"></div>
                {index !== posts.length - 1 && <div class="line"></div>}
              </div>

              <div class="card">
                <div class="meta">
                  <time class="date" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  {index === 0 && <span class="badge">Latest</span>}
                </div>

                <h3>{post.data.title}</h3>

                {post.data.tags?.length ? (
                  <div class="tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                ) : null}
              </div>
            </article>
          ))}
        </section>
      ) : (
        <div class="empty">
          No entries yet. Add your first note in <strong>src/content/learning/</strong>.
        </div>
      )}

      <div class="footer">
        Tip: keep each note short and structured. A daily file with what you learned, what confused you,
        and one takeaway works very well.
      </div>
    </main>
  </body>
</html>
