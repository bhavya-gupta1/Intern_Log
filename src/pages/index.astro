---
import { getCollection, render } from "astro:content";

const posts = (await getCollection("learning")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const formatDate = (date) =>
  date.toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const sameDay = (a, b) =>
  a.getFullYear() === b.getFullYear() &&
  a.getMonth() === b.getMonth() &&
  a.getDate() === b.getDate();

const today = new Date();
today.setHours(0, 0, 0, 0);

const yesterday = new Date(today);
yesterday.setDate(today.getDate() - 1);

const entries = await Promise.all(
  posts.map(async (post, index) => {
    const rendered = await render(post);
    const topics = post.data.topics ?? post.data.tags ?? [];
    const date = new Date(post.data.date);

    return {
      post,
      index,
      topics,
      Content: rendered.Content,
      isToday: sameDay(date, today),
      isYesterday: sameDay(date, yesterday),
      dayName: date.toLocaleDateString("en-US", { weekday: "long" }),
    };
  })
);

const topicCounts = new Map();
for (const entry of entries) {
  for (const topic of entry.topics) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}

const topTopics = [...topicCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Learning Log</title>
    <meta name="description" content="A minimal learning journal timeline." />
    <style>
      :root {
        --bg: #ffffff;
        --text: #1f1f1f;
        --muted: #8a8a8a;
        --line: #ececec;
        --soft: #f7f7f7;
        --accent: #f2a65a;
        --accent-soft: #fff3e4;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 780px;
        margin: 0 auto;
        padding: 54px 22px 72px;
      }

      .top {
        margin-bottom: 34px;
      }

      .eyebrow {
        margin: 0 0 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--muted);
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.3rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
      }

      .sub {
        margin: 12px 0 0;
        max-width: 56ch;
        font-size: 15px;
        line-height: 1.85;
        color: var(--muted);
      }

      .topics {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
      }

      .topics-label {
        width: 100%;
        margin: 0 0 2px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .topic {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--soft);
        font-size: 12px;
        color: #666;
      }

      .topic-count {
        color: var(--muted);
        font-size: 11px;
      }

      .timeline {
        display: grid;
        gap: 28px;
      }

      .entry {
        display: grid;
        grid-template-columns: 18px 1fr;
        gap: 14px;
        align-items: start;
      }

      .rail {
        position: relative;
        display: flex;
        justify-content: center;
        padding-top: 8px;
      }

      .dot {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: #bcbcbc;
      }

      .line {
        position: absolute;
        top: 22px;
        bottom: -32px;
        width: 1px;
        background: var(--line);
      }

      .card {
        padding: 2px 0 0;
      }

      .meta {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
      }

      .date {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .day {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .number {
        font-size: 15px;
        color: var(--muted);
        font-weight: 600;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .badge.today {
        color: #a06b35;
        background: var(--accent-soft);
      }

      .badge.yesterday {
        color: #7c7c7c;
        background: #f3f3f3;
      }

      .body {
        margin-top: 16px;
        display: grid;
        gap: 14px;
      }

      .title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 22px;
        line-height: 1.25;
        letter-spacing: -0.03em;
        font-weight: 700;
      }

      .summary {
        margin: 0;
        font-size: 16px;
        line-height: 1.9;
        color: #2a2a2a;
      }

      .image {
        max-width: 100%;
        border-radius: 18px;
        border: 1px solid var(--line);
        display: block;
      }

      .markdown {
        font-size: 15px;
        line-height: 1.9;
        color: #2a2a2a;
      }

      .markdown :global(p) {
        margin: 0 0 12px;
      }

      .markdown :global(ul),
      .markdown :global(ol) {
        margin: 0 0 12px;
        padding-left: 20px;
      }

      .markdown :global(li) {
        margin: 4px 0;
      }

      .markdown :global(h2),
      .markdown :global(h3) {
        margin: 16px 0 8px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        line-height: 1.3;
        letter-spacing: -0.03em;
      }

      .markdown :global(blockquote) {
        margin: 0;
        padding-left: 14px;
        border-left: 2px solid var(--line);
        color: var(--muted);
      }

      .markdown :global(code) {
        padding: 0.1rem 0.35rem;
        border-radius: 6px;
        background: var(--soft);
        font-size: 0.95em;
      }

      .markdown :global(pre) {
        overflow-x: auto;
        margin: 12px 0;
        padding: 14px 16px;
        border-radius: 16px;
        background: #fafafa;
        border: 1px solid var(--line);
      }

      .markdown :global(pre code) {
        padding: 0;
        background: transparent;
      }

      .empty {
        padding: 30px 0;
        color: var(--muted);
        font-size: 15px;
      }

      @media (max-width: 640px) {
        .page {
          padding: 28px 16px 54px;
        }

        .day {
          font-size: 24px;
        }

        .summary,
        .markdown {
          font-size: 15px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="top">
        <p class="eyebrow">Intern learning log</p>
        <h1>My Learning Log</h1>
        <p class="sub">
        All of my learning in the days of my intern.
        </p>

        {topTopics.length ? (
          <div class="topics" aria-label="Topics learned">
            <p class="topics-label">Topics learned</p>
            {topTopics.map(([topic, count]) => (
              <span class="topic">
                {topic} <span class="topic-count">{count}</span>
              </span>
            ))}
          </div>
        ) : null}
      </header>

      {entries.length ? (
        <section class="timeline">
          {entries.map(({ post, index, topics, Content, isToday, isYesterday, dayName }) => {
            const summary = post.data.summary;
            const image = post.data.image;

            return (
              <article class="entry">
                <div class="rail" aria-hidden="true">
                  <div class="dot"></div>
                  {index !== entries.length - 1 ? <div class="line"></div> : null}
                </div>

                <div class="card">
                  <div class="meta">
                    <div>
                      <div class="date">{formatDate(post.data.date)}</div>
                      <div class="day">{dayName}</div>
                    </div>
                    <div class="number"># {index + 1}</div>
                  </div>

                  <div class="body">
                    <h2 class="title">{post.data.title}</h2>

                    {isToday ? <span class="badge today">Today</span> : null}
                    {!isToday && isYesterday ? <span class="badge yesterday">Yesterday</span> : null}

                    {summary ? <p class="summary">{summary}</p> : null}

                    {image ? <img class="image" src={image} alt={post.data.title} /> : null}

                    <div class="markdown">
                      <Content />
                    </div>

                    {topics.length ? (
                      <div class="topics" style="margin-top: 4px; padding-top: 0; border-top: 0;">
                        {topics.map((topic) => (
                          <span class="topic">{topic}</span>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      ) : (
        <div class="empty">Add Markdown notes in <strong>src/content/learning/</strong>.</div>
      )}
    </main>
  </body>
</html>
